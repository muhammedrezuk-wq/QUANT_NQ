function ageOfTick(ts: number, now: number): [string, string] {
  const ms = ts > 1e11 ? ts : ts * 1000
  const s = Math.max(0, (now - ms) / 1000)
  if (s < 3) return ['ط­ظٹظ‘', 'var(--green)']
